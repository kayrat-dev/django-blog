SECRET_KEY=change-this-secret-key
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=blog_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password

# Настройки для ЛОКАЛЬНОГО запуска (без Docker):
# Для Docker-окружения docker-compose.yml автоматически использует хосты db:5432 и redis:6379
DATABASE_URL=postgres://postgres:change-this-password@localhost:5432/blog_db
CELERY_BROKER_URL=redis://localhost:6379/0

DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com